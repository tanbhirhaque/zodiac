# Discord Bot Application Credentials
# Obtain these from: https://discord.com/developers/applications

# Your Discord Bot Token (Bot tab -> Reset/Copy Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Your Application Client ID (General Information tab -> Application ID)
CLIENT_ID=your_discord_client_id_here

# Target Server (Guild) ID for fast command deployment and setup
# Enable Developer Mode in Discord -> Right-click Server Icon -> Copy Server ID
GUILD_ID=your_target_discord_server_id_here

# Timezone for Automated 9:00 AM & 7:00 PM News Broadcasts (e.g. Asia/Dhaka, America/New_York, UTC)
TIMEZONE=Asia/Dhaka

# Port for Keep-Alive Health Server (Render, Koyeb, Railway will provide this automatically)
PORT=3000
